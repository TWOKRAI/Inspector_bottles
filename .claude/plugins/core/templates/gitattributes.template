# .gitattributes — normalize line endings and mark generated files

# Auto-detect text files and normalize to LF on commit
* text=auto eol=lf

# Force LF for shell/Python/text (avoid CRLF on Windows checkouts)
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf

# claude-kit bundled assets (snippet + template files copied verbatim into
# bootstrapped projects) — force LF so Windows checkouts don't churn the
# diff on first `git add` and confuse linters that re-format on CRLF.
*.snippet      text eol=lf
*.template     text eol=lf
*.snippet.json text eol=lf

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.db    binary
*.sqlite binary
*.pt    binary
*.onnx  binary
*.safetensors binary

# Mark lock files as generated (cleaner PR diffs on GitHub)
uv.lock        linguist-generated=true
package-lock.json linguist-generated=true
poetry.lock    linguist-generated=true

# Журнал сессий только дополняется (одна запись в конец за сессию), поэтому при
# merge/rebase двух веток, писавших в один день, нужны обе записи, а не «наша».
# union склеивает стороны вместо конфликта. Годится ТОЛЬКО для append-only
# файлов: для обычного кода union молча слепит обе версии в мусор.
docs/sessions/*.md merge=union

# Per-role agent memory index (Task 2.4, "Коллизия параллельной записи"): two
# parallel worktrees of the SAME role each append one line to their own
# agent-memory/<role>/MEMORY.md -- same append-only class as docs/sessions/*.md
# above, same fix. Verified empirically: without this, two branches each
# appending at the same insertion point produce a real `CONFLICT (content)` on
# a plain sequential `git merge` (see tests/integration/test_memory_index_merge.py).
.claude/agent-memory/*/MEMORY.md merge=union
