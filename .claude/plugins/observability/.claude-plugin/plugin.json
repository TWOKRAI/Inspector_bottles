{
  "name": "observability",
  "version": "0.5.0",
  "description": "Observability: native OTel telemetry + subagent journal + optional Grafana/ccusage stacks",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agent-journal.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agent-journal.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
