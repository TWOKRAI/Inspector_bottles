// Append this block to your project's .mcp.json under "mcpServers".
// Cross-platform: requires Node 18+ on PATH.
//
// Prerequisites:
//   1. `codegraph init`    — creates .codegraph/ AND builds the first index
//   2. `codegraph status`  — verify the index exists
//   3. Add `.codegraph/` to .gitignore
//
// Two variants — pick one and strip the comments before merging.

// Variant A: global install (npm install -g @colbymchenry/codegraph@1.6.0)
{
  "codegraph": {
    "command": "codegraph",
    "args": ["serve", "--mcp"]
  }
}

// Variant B: zero-install via npx (slower first run, no system-wide footprint)
{
  "codegraph": {
    "command": "npx",
    "args": ["-y", "@colbymchenry/codegraph@1.6.0", "serve", "--mcp"]
  }
}
