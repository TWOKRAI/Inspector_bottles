# Graphify ignore — формат как .gitignore
# См. docs/tools/graphify.md §6.1

# === Legacy snapshots (не индексировать) ===
multiprocess_prototype_backup/
services_backup/

# === Тесты (плоская структура, граф бесполезен) ===
**/tests/
**/test_*.py
**/*_test.py
.pytest_cache/

# === Кэши и сгенерированное ===
**/__pycache__/
**/*.pyc
.coverage
docs/diagrams/classes/*.puml
docs/diagrams/classes/per-module/*.puml
docs/diagrams/deps/*.svg
docs/diagrams/deps/per-module/*.svg

# === Виртуальные окружения ===
.venv/
venv/
env/

# === Сам Graphify ===
graphify-out/
.graphify_*

# === Бинарники и медиа ===
logs/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.mov
*.mp3
*.wav

# === Артефакты сторонних инструментов ===
milvus-docker/
.sentrux/baseline.json

# === Инструментальная конфигурация (не архитектура проекта) ===
/.claude/

# === Scope: 7 целевых каталогов (единый граф с межмодульными связями) ===
# multiprocess_framework, multiprocess_prototype, backend_ctl, Plugins, Services,
# plans, docs. Ведущий слэш якорит паттерн на корне — вложенные config/ внутри
# framework/prototype НЕ исключаются. Исключаем все прочие top-level каталоги.
/Utils/
/config/
/data/
/examples/
/qex/
/robot/
/robot_info/
/scripts/
/templates/
/workspace/
/backend_ctl_records/
/run.py
/conftest.py

# === Архив планов (не индексировать) ===
# graphify и так не берёт его в корпус сканирования, но без ЯВНОГО правила
# расхождение молчит: узел от прежней сборки остаётся в графе как «призрак»
# (fail-closed), а инструмент лишь советует полную пересборку, не называя файл.
# Правило записано, чтобы намерение было проверяемым, а не выводимым.
plans/_archive/
