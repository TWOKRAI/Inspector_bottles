{
  "name": "reference-only",
  "model": "haiku",
  "allowed_tools": [
    "Read"
  ],
  "disallowed_tools": [
    "Bash",
    "Grep",
    "Glob",
    "Edit",
    "Write",
    "NotebookEdit",
    "Agent",
    "WebFetch",
    "WebSearch"
  ],
  "context_files": [
    "docs/arch-map/_bench/k0_reference.json"
  ],
  "prompt_prefix": "Use ONLY the reference file. Read nothing else: no source files, no other documents.",
  "max_turns": 60,
  "max_budget_usd": 1.0,
  "expected_tokens": 60000,
  "thresholds": {
    "hits_min": 6,
    "false_max": 99
  },
  "audit_reads": true
}
