{
  "name": "map-only",
  "model": "haiku",
  "allowed_tools": [
    "Read"
  ],
  "disallowed_tools": [
    "Bash",
    "Grep",
    "Glob",
    "Edit",
    "Write",
    "NotebookEdit",
    "Agent",
    "WebFetch",
    "WebSearch"
  ],
  "context_files": [
    "docs/arch-map/units.md",
    "docs/arch-map/findings.md",
    "docs/arch-map/model.json"
  ],
  "prompt_prefix": "Use ONLY the three listed reference files. Read nothing else: no source files, no other documents.",
  "max_turns": 60,
  "max_budget_usd": 1.0,
  "expected_tokens": 105000,
  "thresholds": {
    "hits_min": 8,
    "false_max": 1,
    "calls_ratio_max": 0.5,
    "tokens_ratio_max": 0.6
  },
  "audit_reads": true
}
