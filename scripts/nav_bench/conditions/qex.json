{
  "name": "qex",
  "model": "haiku",
  "allowed_tools": [
    "Read",
    "Grep",
    "Glob",
    "mcp__qex__search_code"
  ],
  "disallowed_tools": [
    "Bash",
    "Edit",
    "Write",
    "NotebookEdit",
    "Agent",
    "WebFetch",
    "WebSearch"
  ],
  "context_files": [],
  "max_turns": 60,
  "max_budget_usd": 1.0,
  "thresholds": {
    "hits_min": 8,
    "false_max": 1,
    "calls_ratio_max": 0.5,
    "tokens_ratio_max": 0.6
  },
  "mcp_config": "conditions/mcp/qex.json",
  "requires": [
    "qex-index"
  ],
  "prompt_prefix": "Besides Read/Grep/Glob you have mcp__qex__search_code; call it with path=\"{run_root}\". Confirm a place by reading it.",
  "expected_tokens": 70000
}
